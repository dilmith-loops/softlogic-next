# ==============================================================================
# Hostinger (hPanel) Apache / LiteSpeed Configuration for /softlogic
# ==============================================================================
Options -Indexes -MultiViews +FollowSymLinks
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /softlogic/

  # Pass Authorization header to PHP in CGI/FastCGI/LiteSpeed
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # 1. Block Access to Hidden Files, Sensitive Directories & Development Artifacts
  # Block dotfiles (.env, .git, etc.)
  RewriteRule (^|/)\. - [F,L]

  # Block direct web access to raw source directories
  RewriteRule ^(backend|frontend|storage|tests|vendor)/ - [F,L]

  # Block direct access to database dumps, lockfiles, configs, and source files
  RewriteRule \.(sql|sqlite|lock|xml|md|log|env|yml|yaml|ts|tsx|sh)$ - [F,L]
  RewriteRule ^(package|composer)\.(json|lock)$ - [F,L]

  # 2. Direct route for root directory to index.php
  RewriteRule ^$ index.php [L]

  # 3. Subdirectory page routes
  RewriteRule ^exam/?$ exam/index.html [L]
  RewriteRule ^admin/?$ admin/index.html [L]
  RewriteRule ^admin/login/?$ admin/login/index.html [L]

  # 4. Route API requests to api/index.php
  RewriteRule ^api/(.*)$ api/index.php [L,QSA]
  RewriteRule ^api/?$ api/index.php [L,QSA]

  # 5. Serve existing static assets directly (CSS, JS, images, videos)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 6. Dual-path fallback for images or media
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/softlogic/images/$1 -f
  RewriteRule ^([^/]+\.(jpg|jpeg|png|svg|webp|ico))$ images/$1 [L]

  # 7. Fallback to index.html for Next.js SPA client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# Byte-Range Streaming Support & Strict Security Headers
<IfModule mod_headers.c>
  Header set Accept-Ranges bytes
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header unset X-Powered-By
</IfModule>

# Caching & MIME Types for High-Performance Streaming
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType image/jpeg .jpg .jpeg
  AddType image/png .png
  AddType image/svg+xml .svg
  AddType text/css .css
  AddType application/javascript .js
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"

  # HTML & JSON & PHP must NEVER be cached by server expires
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/x-httpd-php "access plus 0 seconds"
  
  # Media
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  
  # Styles & Scripts
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
