# ==============================================================================
# Hostinger (hPanel) Apache / LiteSpeed Configuration for /softlogic
# ==============================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /softlogic/

  # Ensure trailing slash on directory visits (prevents relative link breaks)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ /softlogic/$1/ [L,R=301]

  # Route API requests to api/index.php
  RewriteRule ^api/(.*)$ api/index.php [L,QSA]
  RewriteRule ^api$ api/index.php [L,QSA]

  # Clean URLs with trailing slash (e.g. /softlogic/exam/ -> exam/index.html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)/$ $1/index.html [L]

  # Clean URLs without extension (e.g. /softlogic/exam -> exam/index.html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # Fallback to index.html for Next.js SPA client-side routing
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Byte-Range Streaming Support for Videos
<IfModule mod_headers.c>
  Header set Accept-Ranges bytes
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Caching & MIME Types for High-Performance Streaming
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType image/jpeg .jpg .jpeg
  AddType image/png .png
  AddType image/svg+xml .svg
  AddType text/css .css
  AddType application/javascript .js
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"

  # HTML pages should revalidate immediately
  ExpiresByType text/html "access plus 0 seconds"
  
  # Media
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  
  # Styles & Scripts
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
