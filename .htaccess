# ==============================================================================
# Hostinger (hPanel) Apache / LiteSpeed Configuration for /softlogic
# ==============================================================================
Options -Indexes +FollowSymLinks
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /softlogic/

  # 1. Direct route for root directory to index.html (LiteSpeed fix)
  RewriteRule ^$ index.html [L]

  # 2. Subdirectory page routes
  RewriteRule ^exam/?$ exam/index.html [L]
  RewriteRule ^admin/?$ admin/index.html [L]
  RewriteRule ^admin/login/?$ admin/login/index.html [L]

  # 3. Route API requests to api/index.php
  RewriteRule ^api/(.*)$ api/index.php [L,QSA]
  RewriteRule ^api/?$ api/index.php [L,QSA]

  # 4. Serve existing files directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. Dual-path fallback for images or media
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/softlogic/images/$1 -f
  RewriteRule ^([^/]+\.(jpg|jpeg|png|svg|webp|ico))$ images/$1 [L]

  # 6. Fallback to index.html for Next.js SPA client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

# Byte-Range Streaming Support for Videos
<IfModule mod_headers.c>
  Header set Accept-Ranges bytes
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Caching & MIME Types for High-Performance Streaming
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType image/jpeg .jpg .jpeg
  AddType image/png .png
  AddType image/svg+xml .svg
  AddType text/css .css
  AddType application/javascript .js
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"

  # HTML pages should revalidate immediately
  ExpiresByType text/html "access plus 0 seconds"
  
  # Media
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  
  # Styles & Scripts
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
