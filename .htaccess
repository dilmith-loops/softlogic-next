# ==============================================================================
# Route every request into Laravel's public/ directory.
# Nothing outside public/ (app/, .env, vendor/, storage/ ...) is reachable.
# ==============================================================================
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /softlogic/

    # Direct root visits to public/index.html
    RewriteRule ^$ public/index.html [L]

    # Prevent loop once inside public/
    RewriteRule ^public/ - [L]

    # Rewrite all traffic into public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>


