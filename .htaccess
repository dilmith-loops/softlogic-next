# ==============================================================================
# Route every request into Laravel's public/ directory.
# Nothing outside public/ (app/, .env, vendor/, storage/ ...) is reachable.
# ==============================================================================
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent loop once inside public/
    RewriteRule ^public/ - [L]

    # Rewrite all traffic into public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>

