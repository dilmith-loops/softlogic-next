# ==============================================================================
# Hostinger (hPanel): the repo is deployed to public_html/softlogic, so route every
# request into Laravel's public/ directory. Nothing outside public/ (app/, .env,
# vendor/, storage/ ...) is reachable from the web.
# ==============================================================================
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{REQUEST_URI} !/public/
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
  Require all denied
</IfModule>
